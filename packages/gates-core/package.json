{
  "name": "@emdash/gates-core",
  "version": "0.1.0",
  "description": "Framework-free verification gates: runner, evidence store, self-heal policy and built-in gates",
  "license": "Apache-2.0",
  "author": {
    "name": "Advance Labs Inc.",
    "email": "lucas@advancelabs.dev"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./untrusted": {
      "development": "./src/untrusted.ts",
      "types": "./dist/untrusted.d.mts",
      "default": "./dist/untrusted.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emdash/citations": "workspace:*",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/pngjs": "^6.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.0"
  }
}
