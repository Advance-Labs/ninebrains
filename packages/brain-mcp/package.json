{
  "name": "@ninebrains/brain-mcp",
  "version": "0.1.0",
  "description": "Stdio MCP server exposing the Ninebrains Brain to Claude Code and Codex lanes.",
  "license": "Apache-2.0",
  "author": {
    "name": "Advance Labs Inc.",
    "email": "lucas@advancelabs.dev"
  },
  "bin": {
    "ninebrains-brain-mcp": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emdash/gates-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ninebrains/brain-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
